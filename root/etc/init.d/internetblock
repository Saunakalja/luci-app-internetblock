USE_PROCD=1
START=95
STOP=10

start_service() {
	/usr/libexec/internetblock init || return 1
	procd_open_instance
	procd_set_param command /usr/libexec/internetblock-worker
	procd_set_param respawn
	procd_close_instance
}

service_started() {
	# rc.common calls this after registering the worker. Return only after our
	# firewall state is applied, rather than relying on a background start race.
	/usr/libexec/internetblock apply
}

service_stopped() {
	/usr/libexec/internetblock flush >/dev/null 2>&1
	/usr/libexec/internetblock cleanup
}

reload_service() {
	/usr/libexec/internetblock apply
}

service_triggers() {
	procd_add_reload_trigger internetblock network
}
